{
  "name": "toolspan-mcp",
  "version": "0.7.1",
  "description": "Remote tools for AI agents.",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "^22.17.0 || ^24.0.0",
    "npm": "10.9.2"
  },
  "files": [
    "dist/**",
    "npm-shrinkwrap.json",
    "deploy/cloudflared/config.example.yml",
    "docs/deployment.md",
    "docs/product-contract.md",
    "docs/threat-model.md",
    "docs/usage/**",
    "docs/setup/**",
    "docs/prompts/**",
    "config/*.json",
    "schemas/desktop-protocol.v1.schema.json",
    "schemas/setup-*.json",
    "scripts/package-runtime-policy.mjs",
    "scripts/runtime-preflight.mjs",
    "toolspan.config.example.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "SECURITY.md",
    "SUPPORT.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node scripts/bundle-desktop-host.mjs",
    "package:shrinkwrap": "node scripts/generate-publish-shrinkwrap.mjs",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "password:init": "node dist/cli/init-password.js",
    "password:init:dev": "tsx src/cli/init-password.ts",
    "doctor": "node dist/cli/doctor.js",
    "doctor:dev": "tsx src/cli/doctor.ts",
    "preflight": "node scripts/runtime-preflight.mjs",
    "goal:preflight": "node scripts/goal-preflight.mjs",
    "goal:check": "node scripts/goal-check.mjs",
    "goal:status": "node scripts/goal-status.mjs",
    "check:brand": "node scripts/check-brand.mjs",
    "check:version": "node scripts/check-version.mjs",
    "check:contract": "npm run build && node scripts/check-contract.mjs",
    "check:openai-plan-usage": "node scripts/check-openai-plan-usage.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:oss": "node scripts/check-oss.mjs",
    "check:ci": "node scripts/check-ci.mjs",
    "verify:core": "node scripts/verify-core.mjs",
    "smoke:core-release": "node scripts/smoke-core-release.mjs",
    "desktop:install": "node scripts/desktop-install.mjs",
    "desktop:protocol:check": "npm run build && node scripts/check-desktop-protocol.mjs",
    "check:desktop:security": "node scripts/check-desktop-security.mjs",
    "verify:desktop:source": "node scripts/verify-desktop-source.mjs",
    "verify:desktop:windows": "node scripts/verify-desktop-windows.mjs",
    "setup:test": "vitest run setup",
    "check:setup-docs": "node scripts/check-setup-docs.mjs",
    "check:setup-prompts": "node scripts/check-setup-prompts.mjs",
    "check:commercial-links": "node scripts/check-commercial-links.mjs",
    "check:affiliate-disclosure": "node scripts/check-affiliate-disclosure.mjs",
    "check:vendor-assets": "node scripts/check-vendor-assets.mjs",
    "smoke:setup-manifest": "node scripts/smoke-setup-manifest.mjs",
    "check:setup:security": "node scripts/check-setup-security.mjs",
    "verify:setup": "node scripts/verify-setup.mjs",
    "verify:all:source": "node scripts/verify-all-source.mjs",
    "check:test-environment": "node scripts/check-test-environment.mjs",
    "release:dry-run": "node scripts/release-dry-run.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "e2e:mcp-inspector": "node scripts/e2e-mcp-inspector.mjs",
    "e2e:codex-remote": "node scripts/e2e-codex-remote.mjs",
    "e2e:host:local": "node scripts/e2e-host-local.mjs",
    "e2e:cloudflare": "node scripts/e2e-cloudflare.mjs",
    "e2e:cloudflare-public": "node scripts/e2e-cloudflare-public.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "bcryptjs": "3.0.3",
    "express": "5.2.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.1",
    "@types/supertest": "7.2.1",
    "esbuild": "0.28.1",
    "supertest": "7.2.2",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
