{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toolspan.invalid/schemas/commercial-links.schema.json",
  "title": "ToolSpan commercial links",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "provider", "affiliateId", "coupon", "links"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "provider": { "const": "namesilo" },
    "affiliateId": { "type": "string", "pattern": "^[A-Za-z0-9]+$" },
    "coupon": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": ["home", "search", "pricing"],
      "properties": {
        "home": { "$ref": "#/$defs/link" },
        "search": { "$ref": "#/$defs/link" },
        "pricing": { "$ref": "#/$defs/link" }
      }
    }
  },
  "$defs": {
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direct"],
      "properties": {
        "direct": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://www\\.namesilo\\.com/"
        }
      }
    }
  }
}
