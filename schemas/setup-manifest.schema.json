{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toolspan.dev/schemas/setup-manifest.v1.json",
  "title": "ToolSpan Setup Safe Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "toolSpanVersion",
    "instanceName",
    "localUrl",
    "desiredHostname",
    "publicMcpUrl",
    "oauthDiscoveryUrl",
    "expectedToolCount",
    "tunnelName",
    "domainChoice",
    "officialDocs",
    "generatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "toolSpanVersion": { "type": "string", "pattern": "^0\\.5\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "instanceName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "localUrl": { "type": "string", "format": "uri", "pattern": "^http://(?:127\\.0\\.0\\.1|localhost)(?::[0-9]{1,5})?/?$" },
    "desiredHostname": { "$ref": "#/$defs/hostname" },
    "publicMcpUrl": { "type": "string", "format": "uri", "pattern": "^https://[^/?#]+/mcp$" },
    "oauthDiscoveryUrl": { "type": "string", "format": "uri", "pattern": "^https://[^/?#]+/\\.well-known/" },
    "expectedToolCount": { "const": 27 },
    "tunnelName": { "type": "string", "minLength": 1, "maxLength": 100 },
    "domainChoice": { "enum": ["existing", "other_registrar", "namesilo_no_referral"] },
    "officialDocs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "format": "uri", "pattern": "^https://(?:developers\\.cloudflare\\.com|developers\\.openai\\.com)/" }
    },
    "generatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "hostname": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^(?=.{1,253}$)(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z]{2,63}$"
    }
  }
}
