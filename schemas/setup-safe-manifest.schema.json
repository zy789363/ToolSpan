{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toolspan.invalid/schemas/setup-safe-manifest.schema.json",
  "title": "ToolSpan Setup safe agent manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "toolSpanVersion",
    "instanceName",
    "localUrl",
    "desiredHostname",
    "publicMcpUrl",
    "oauthDiscoveryUrl",
    "expectedToolCount",
    "tunnelName",
    "domainChoice",
    "officialDocs",
    "generatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "toolSpanVersion": { "type": "string", "pattern": "^0\\.5\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "instanceName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "localUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^http://(?:127\\.0\\.0\\.1|localhost)(?::[0-9]{1,5})?/?$"
    },
    "desiredHostname": {
      "type": "string",
      "pattern": "^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "publicMcpUrl": { "type": "string", "format": "uri", "pattern": "^https://[^/?#]+/mcp$" },
    "oauthDiscoveryUrl": { "type": "string", "format": "uri", "pattern": "^https://[^/?#]+/\\.well-known/" },
    "expectedToolCount": { "const": 27 },
    "tunnelName": { "type": "string", "minLength": 1, "maxLength": 100 },
    "domainChoice": {
      "enum": ["existing", "other_registrar", "namesilo_referral", "namesilo_no_referral"]
    },
    "officialDocs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://(?:developers\\.cloudflare\\.com|developers\\.openai\\.com)/"
      }
    },
    "generatedAt": { "type": "string", "format": "date-time" }
  }
}
