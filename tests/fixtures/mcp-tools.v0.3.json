[
  {
    "name": "apply_patch",
    "description": "Validate and transactionally apply up to 50 structured text file operations.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "operations": {
          "minItems": 1,
          "maxItems": 50,
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "op": {
                    "type": "string",
                    "const": "create_file"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "content": {
                    "type": "string",
                    "maxLength": 1048576
                  }
                },
                "required": [
                  "op",
                  "path",
                  "content"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "type": "string",
                    "const": "edit_file"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "oldText": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1048576
                  },
                  "newText": {
                    "type": "string",
                    "maxLength": 1048576
                  }
                },
                "required": [
                  "op",
                  "path",
                  "oldText",
                  "newText"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "op": {
                    "type": "string",
                    "const": "delete_file"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "expectedSha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "op",
                  "path",
                  "expectedSha256"
                ]
              }
            ]
          }
        },
        "dryRun": {
          "type": "boolean"
        }
      },
      "required": [
        "workspaceId",
        "operations"
      ]
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false
    },
    "securitySchemes": [
      {
        "type": "oauth2",
        "scopes": [
          "workspace:write"
        ]
      }
    ],
    "requiredScopes": [
      "workspace:write"
    ]
  },
